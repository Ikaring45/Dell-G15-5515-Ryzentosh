     // MARK: - FPS
     
+    #if arch(x86_64)
+    // This global NullMoth counter measures desktop display flips, not game FPS.
+    private func readRTXDisplayFPS() -> Double? {
+        var flips: UInt64 = 0
+        var size = MemoryLayout<UInt64>.size
+        guard sysctlbyname("debug.nvrmfb_flip_n", &flips, &size, nil, 0) == 0,
+              size == MemoryLayout<UInt64>.size else {
+            self.previousRTXSample = nil
+            return nil
+        }
+        let now = ProcessInfo.processInfo.systemUptime
+        defer { self.previousRTXSample = (flips, now) }
+        guard let previous = self.previousRTXSample, now > previous.time, flips >= previous.flips else {
+            return nil
+        }
+        return Double(flips - previous.flips) / (now - previous.time)
+    }
+    #endif
